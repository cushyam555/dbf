<Window x:Class="MixerStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mixer Studio • คัดเพลงซ้ำ EMK / NCN" Width="1320" Height="940" MinWidth="1120" MinHeight="840" Background="#0C1424" FontFamily="Leelawadee UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="OnClosing">
<Grid Background="#0C1424"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#111C30" Padding="20,30"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="◈ MIXER" FontSize="25" FontWeight="Bold" Foreground="#7EB5FF"/><TextBlock Text="EMK / NCN RECONSTRUCTION" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,4,0,35"/><Border Background="#243A5B" CornerRadius="9" Padding="12"><TextBlock Text="♫  คัดเพลงซ้ำ" FontWeight="SemiBold"/></Border><TextBlock Text="01  เปิด Song.dbf" Margin="0,30,0,18"/><TextBlock Text="02  เลือกเกณฑ์คัดซ้ำ" Margin="0,0,0,18"/><TextBlock Text="03  ส่งออกเพลงที่เก็บ"/><TextBlock Text="ต้นทาง NCN ต้องมี&#10;Song / Lyrics / Cursor" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,30,0,0"/></StackPanel><TextBlock Text="เวอร์ชัน 0.3&#10;ฐานข้อมูล Windows-874" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/></DockPanel></Border>
<Grid Grid.Column="1" Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="ค้นหาและคัดเพลงซ้ำ" FontSize="28" FontWeight="Bold"/><TextBlock Text="เปรียบเทียบชื่อเพลง นักร้อง และเนื้อเพลงจาก Song.dbf" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock Text="EMK + NCN" Foreground="#79DFBD" HorizontalAlignment="Right" Margin="0,10,0,0"/></Grid>
<Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="16" Margin="0,18,0,12"><StackPanel x:Name="FoldersPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Extreme" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ExtremePath" IsReadOnly="True" AutomationProperties.Name="โฟลเดอร์ Extreme"/><Button Grid.Column="2" Content="เลือกโฟลเดอร์…" Click="ChooseExtreme" Margin="8,0,0,0"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EMK" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="EmkPath" IsReadOnly="True" AutomationProperties.Name="โฟลเดอร์ EMK"/><Button Grid.Column="2" Content="เลือกโฟลเดอร์…" Click="ChooseEmk" Margin="8,0,0,0"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="NCN" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="NcnPath" IsReadOnly="True" AutomationProperties.Name="โฟลเดอร์ NCN"/><Button Grid.Column="2" Content="เลือกโฟลเดอร์…" Click="ChooseNcn" Margin="8,0,0,0"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="เปิด Song.dbf" Background="#3478F6" Click="OpenDatabase"/><TextBlock Grid.Column="1" x:Name="DatabasePath" Text="ยังไม่ได้เปิดฐานข้อมูล" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/></Grid></StackPanel></Border>
<StackPanel Grid.Row="2" x:Name="FilterPanel" Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="FilterTitleButton" Content="คัดซ้ำ: ชื่อเพลง + เนื้อเพลง" Click="FilterTitle"/><Button x:Name="FilterArtistButton" Content="คัดซ้ำ: นักร้อง + เนื้อเพลง" Click="FilterArtist" Margin="8,0"/><CheckBox x:Name="EmkFirst" Content="เลือก EMK ก่อน" IsChecked="True" Margin="8,0" Checked="PriorityChanged" Unchecked="PriorityChanged"/><Button Content="คืนรายการทั้งหมด" Click="ResetFilter" Margin="8,0,0,0"/></StackPanel>
<UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,12"><Border Background="#172238" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="ต้นฉบับจาก DBF" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" Text="0" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#172238" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="คัดเหลือ / เก็บไว้" Foreground="{StaticResource Muted}"/><TextBlock x:Name="KeptText" Text="0" FontSize="25" Foreground="#79DFBD"/></StackPanel></Border><Border Background="#172238" CornerRadius="10" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="รายการซ้ำที่คัดออก" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DuplicateText" Text="0" FontSize="25" Foreground="#F6C77A"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="4" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ViewMode" SelectedIndex="0" SelectionChanged="ViewChanged" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="รายการที่แสดง"><ComboBoxItem Content="เพลงที่เก็บไว้"/><ComboBoxItem Content="เพลงซ้ำที่คัดออก"/><ComboBoxItem Content="เปรียบเทียบทุกกลุ่ม"/></ComboBox><TextBox Grid.Column="1" x:Name="Search" TextChanged="SearchChanged" Margin="8,0" AutomationProperties.Name="ค้นหารหัส ชื่อเพลง นักร้อง หรือเนื้อเพลง" ToolTip="ค้นหารหัส ชื่อเพลง นักร้อง หรือเนื้อเพลง"/><TextBlock Grid.Column="2" x:Name="TypeCount" Text="EMK 0 · NCN 0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
<Border Grid.Row="5" Background="#131E31" CornerRadius="10" ClipToBounds="True"><Grid><DataGrid x:Name="SongsGrid" AutoGenerateColumns="True" AutoGeneratingColumn="GridColumn" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="#131E31" AlternatingRowBackground="#17243A" Background="Transparent" BorderThickness="0" Foreground="#EAF0FC" RowHeight="40" EnableRowVirtualization="True" EnableColumnVirtualization="True"/><TextBlock x:Name="Empty" Text="เปิด Song.dbf เพื่อเริ่มคัดเพลงซ้ำ" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/></Grid></Border>
<StackPanel Grid.Row="6" Margin="0,12,0,0"><StackPanel x:Name="OptionsPanel" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="เริ่มรหัสที่" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StartLetter" Width="65" Padding="8" AutomationProperties.Name="ตัวอักษรเริ่มต้น"/><TextBlock Text="เพลงต่อโฟลเดอร์" VerticalAlignment="Center" Margin="18,0,8,0"/><TextBox x:Name="PerFolder" Width="85" Text="20000" ToolTip="กำหนดได้ 1–99,999 เพลง หรือเลือกไม่จำกัด" AutomationProperties.Name="จำนวนเพลงต่อโฟลเดอร์"/><CheckBox x:Name="UnlimitedFolder" Content="ไม่จำกัด" Margin="16,0,0,0" Checked="UnlimitedChanged" Unchecked="UnlimitedChanged" ToolTip="ส่งออกทั้งหมดในโฟลเดอร์ตัวอักษรเดียว รหัสจะยาวขึ้นเมื่อเกิน 99,999 เพลง"/><Button Content="ตรวจไฟล์ก่อนส่งออก" Click="PreviewExport" Margin="18,0,0,0"/></StackPanel><TextBlock x:Name="ExportPath" Text="ปลายทาง: เลือกโฟลเดอร์ Extreme ก่อน" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/><ProgressBar x:Name="Progress" Height="5" Foreground="#3478F6" Background="#25334A" Maximum="100"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="พร้อมเริ่มงาน" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="ProgressText" Text="EMK: 0 · NCN: 0" Foreground="#83B6FF" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="StopButton" Grid.Column="1" Content="หยุด" IsEnabled="False" Click="StopClick" Margin="8,0"/><Button x:Name="CopyButton" Grid.Column="2" Content="สำเนาเพลงที่เก็บ → Export" IsEnabled="False" Background="#3478F6" Click="CopyClick"/><Button x:Name="MoveButton" Grid.Column="3" Content="ย้ายเพลงที่เก็บ → Export" IsEnabled="False" Background="#8D4D36" Click="MoveClick" Margin="8,0,0,0"/></Grid></StackPanel>
</Grid></Grid></Window>
