<Window x:Class="MixerStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mixer Studio • EMK / NCN" Width="1240" Height="850" MinWidth="1000" MinHeight="730" Background="#0C1424" FontFamily="Leelawadee UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Closing="OnClosing">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#111C30" Padding="24,30"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="◈ MIXER" FontSize="25" FontWeight="Bold" Foreground="#7EB5FF"/><TextBlock Text="STUDIO / WINDOWS" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,42"/><Border Background="#243A5B" CornerRadius="9" Padding="14,12"><TextBlock Text="♫   คลังเพลง" FontWeight="SemiBold"/></Border><TextBlock Text="ขั้นตอนการใช้งาน" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,32,0,16"/><TextBlock Text="01   เลือกโฟลเดอร์" Margin="0,0,0,20"/><TextBlock Text="02   ตรวจสอบรายการ" Margin="0,0,0,20"/><TextBlock Text="03   คัดลอกไฟล์"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="เวอร์ชันเริ่มต้น 0.1" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="EMK / NCN File Organizer" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="30,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="จัดการคลังเพลง" FontSize="28" FontWeight="Bold"/><TextBlock Text="ค้นหา ตรวจสอบไฟล์ประกอบ และคัดลอกเพลงในที่เดียว" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Border Background="#193A39" CornerRadius="14" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="●  ทำงานในเครื่อง" Foreground="#79DFBD" FontSize="12"/></Border></Grid>
<Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Margin="0,22,0,14"><StackPanel><TextBlock Text="01  เลือกโฟลเดอร์ต้นทาง" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Source" IsReadOnly="True" AutomationProperties.Name="โฟลเดอร์ต้นทาง"/><Button x:Name="BrowseSource" Grid.Column="1" Content="เลือกโฟลเดอร์…" Margin="8,0" Click="ChooseSource"/><Button x:Name="ScanButton" Grid.Column="2" Content="สแกนไฟล์" Background="#3478F6" Click="ScanClick"/></Grid><TextBlock Text="รวมโฟลเดอร์ย่อย • รองรับ .emk .mid .midi .lyr .cur" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
<UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14"><Border Background="#172238" CornerRadius="10" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="รายการเพลง" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalText" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#172238" CornerRadius="10" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="ไฟล์ประกอบขาด / ซ้ำ" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IssuesText" Text="0" FontSize="26" Foreground="#F6C77A" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#172238" CornerRadius="10" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="เลือกเพื่อคัดลอก" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedText" Text="0" FontSize="26" Foreground="#83B6FF" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="3" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" AutomationProperties.Name="ค้นหารหัสหรือชื่อไฟล์" ToolTip="ค้นหารหัส ชื่อไฟล์ หรือโฟลเดอร์" TextChanged="FilterChanged"/><CheckBox x:Name="OnlyIssues" Grid.Column="1" Content="เฉพาะที่ต้องตรวจสอบ" Margin="16,0" Checked="FilterChanged" Unchecked="FilterChanged"/><Button Grid.Column="2" Content="เลือกที่แสดงทั้งหมด" Click="SelectVisible"/></Grid>
<Border Grid.Row="4" Background="#131E31" CornerRadius="10" ClipToBounds="True"><Grid><DataGrid x:Name="SongsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="#131E31" AlternatingRowBackground="#17243A" Background="Transparent" BorderThickness="0" Foreground="#EAF0FC" RowHeight="44" EnableRowVirtualization="True" SelectionMode="Extended"><DataGrid.Columns><DataGridCheckBoxColumn Header="เลือก" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridTextColumn Header="รหัส / ชื่อไฟล์" Binding="{Binding Code}" IsReadOnly="True" Width="160"/><DataGridTextColumn Header="ประเภท" Binding="{Binding Kind}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="ผลตรวจไฟล์" Binding="{Binding Status}" IsReadOnly="True" Width="210"/><DataGridTextColumn Header="ตำแหน่งต้นทาง" Binding="{Binding RelativePath}" IsReadOnly="True" Width="*" MinWidth="140"/></DataGrid.Columns></DataGrid><TextBlock x:Name="Empty" Text="เริ่มต้นด้วยการเลือกโฟลเดอร์ แล้วกด “สแกนไฟล์”" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/></Grid></Border>
<StackPanel Grid.Row="5" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="พร้อมเริ่มงาน • คัดลอกโดยคงโครงสร้างโฟลเดอร์เดิม" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><ProgressBar x:Name="Progress" Height="5" Foreground="#3478F6" Background="#25334A" Maximum="100"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="03  ปลายทางสำหรับคัดลอก" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="Destination" IsReadOnly="True" AutomationProperties.Name="โฟลเดอร์ปลายทาง"/></StackPanel><Button x:Name="BrowseDest" Grid.Column="1" Content="เลือก…" VerticalAlignment="Bottom" Margin="8,0" Click="ChooseDestination"/><Button x:Name="CancelButton" Grid.Column="2" Content="หยุด" VerticalAlignment="Bottom" Margin="0,0,8,0" IsEnabled="False" Click="CancelClick"/><Button x:Name="ExportButton" Grid.Column="3" Content="คัดลอกเพลงที่เลือก →" VerticalAlignment="Bottom" Background="#3478F6" IsEnabled="False" Click="ExportClick"/></Grid><TextBlock Text="จับคู่ NCN ตามชื่อไฟล์ • ยังไม่อ่าน DBF หรือแปลง EMK ↔ NCN" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
</Grid></Grid></Window>
