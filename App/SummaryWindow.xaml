<Window x:Class="MixerStudio.SummaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="สรุปก่อนทำงาน" Width="790" Height="680" MinWidth="700" MinHeight="580" Background="#0C1424" FontFamily="Leelawadee UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
<Border Background="#0C1424"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="ActionTitle" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ActionNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/></StackPanel><Border Grid.Row="1" Background="#172238" CornerRadius="10" Padding="18"><TextBlock x:Name="CountsText" FontSize="16" TextWrapping="Wrap" LineHeight="28"/></Border><TextBlock Grid.Row="2" x:Name="LocationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,12"/><TextBox Grid.Row="3" x:Name="Details" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="กลับไปตรวจสอบ" Click="CancelClicked" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Content="ยืนยันและเริ่มงาน" Background="#3478F6" Click="ConfirmClicked"/></StackPanel></Grid></Border></Window>
