<Window x:Class="MixerStudio.GroupsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="เปรียบเทียบกลุ่มเพลงซ้ำ" Width="1080" Height="670" MinWidth="900" MinHeight="560" Background="#0C1424" FontFamily="Leelawadee UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="เปรียบเทียบแล้วเลือกเพลงที่ต้องการเก็บ" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="เลือกกลุ่มทางซ้าย จากนั้นเลือกเพลงและกด “เก็บเพลงนี้” มีผลเมื่อกดใช้ตัวเลือก" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,16,0"><TextBox x:Name="GroupSearch" DockPanel.Dock="Top" TextChanged="SearchGroups" ToolTip="ค้นหากลุ่มเพลง" Margin="0,0,0,8"/><ListBox x:Name="GroupList" Background="#172238" Foreground="#EAF0FC" BorderThickness="0" SelectionChanged="GroupChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Reason" MaxHeight="100" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#83B6FF"/><DataGrid Grid.Row="1" x:Name="Candidates" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" RowBackground="#172238" AlternatingRowBackground="#1B2941" Foreground="#EAF0FC" Background="#131E31" BorderThickness="0" RowHeight="42"><DataGrid.Columns><DataGridTextColumn Header="ผลการคัด" Binding="{Binding [ผลการคัด]}" Width="80"/><DataGridTextColumn Header="รหัสเพลง" Binding="{Binding [CODE]}" Width="100"/><DataGridTextColumn Header="ประเภท" Binding="{Binding [SUB_TYPE]}" Width="85"/><DataGridTextColumn Header="ชื่อเพลง" Binding="{Binding [TITLE]}" Width="180"/><DataGridTextColumn Header="นักร้อง" Binding="{Binding [ARTIST]}" Width="150"/><DataGridTextColumn Header="เนื้อเพลง" Binding="{Binding [LYR_TITLE]}" Width="220"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" x:Name="KeepCandidate" Content="เก็บเพลงนี้" HorizontalAlignment="Right" Background="#3478F6" Click="KeepClicked" Margin="0,12,0,0"/></Grid></Grid>
<Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="ChoiceCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="ยกเลิก" Click="CancelClicked" Margin="0,0,8,0"/><Button Content="ใช้ตัวเลือก" Background="#3478F6" Click="AcceptClicked"/></StackPanel></Grid></Grid></Window>
